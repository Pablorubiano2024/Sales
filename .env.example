APP_ENV=development

# Without DATABASE_URL -> SQLite local en ./data/arbitrage.db (desarrollo).
# Con DATABASE_URL -> PostgreSQL (despliegue: Neon). Formato:
#   postgresql://usuario:password@host/basename?sslmode=require
DATABASE_URL=sqlite:///./data/arbitrage.db

API_HOST=127.0.0.1
API_PORT=8000

# When set, all /api/* endpoints require this value in an `X-API-Key` header.
# Leave blank for local-only use; set it before deploying anywhere public.
API_AUTH_TOKEN=

# Streamlit -> FastAPI (frontend/api_client.py)
BACKEND_API_URL=http://127.0.0.1:8000

# Candado de contraseña para el frontend (solo si se publica públicamente).
# Vacío = sin candado. En Streamlit Cloud se define en Secrets, no aquí.
APP_PASSWORD=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Dropi (proveedor) — aún no integrado de verdad, ver
# backend/app/integrations/dropi.py. Se genera desde el panel de Dropi,
# sección Integraciones, una vez tengas cuenta.
DROPI_INTEGRATION_KEY=

# CJdropshipping (proveedor) — integración real y verificada, ver
# backend/app/integrations/cjdropshipping.py. Se genera en tu cuenta CJ:
# Apps -> instala la app "API" -> página "Get API Key".
CJ_API_KEY=

MIN_ROI=0.30
MIN_NET_PROFIT=20000
MAX_RISK_SCORE=0.50

DEFAULT_CURRENCY=COP

# Tasa USD -> COP usada para convertir precios de fuentes en USD (como
# CJdropshipping) antes de calcular rentabilidad contra los umbrales COP de
# arriba. No se consulta en vivo — revisa la TRM oficial (banrep.gov.co) y
# actualiza este valor si se ha alejado. Por defecto: TRM del 18/09/2026.
USD_TO_COP_RATE=3130

# Comisión de marketplace restada a cada oportunidad descubierta. La real de
# MercadoLibre Colombia va del 8% al 19% según categoría (hasta 22% con
# cuotas extra) — verifica la tuya en mercadolibre.com.co/ayuda.
MARKETPLACE_COMMISSION_PCT=0.15

# Envío estimado (COP) restado a cada oportunidad: CJ China->Colombia +
# envío nacional subsidiado ("envío gratis"). No es un dato exacto por
# producto — usa la calculadora de flete real de CJ si necesitas precisión.
SHIPPING_COST_COP=29000
