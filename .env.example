APP_ENV=development

# Without DATABASE_URL -> SQLite local en ./data/arbitrage.db (desarrollo).
# Con DATABASE_URL -> PostgreSQL (despliegue: Neon). Formato:
#   postgresql://usuario:password@host/basename?sslmode=require
DATABASE_URL=sqlite:///./data/arbitrage.db

API_HOST=127.0.0.1
API_PORT=8000

# When set, all /api/* endpoints require this value in an `X-API-Key` header.
# Leave blank for local-only use; set it before deploying anywhere public.
API_AUTH_TOKEN=

# Streamlit -> FastAPI (frontend/api_client.py)
BACKEND_API_URL=http://127.0.0.1:8000

# Candado de contraseña para el frontend (solo si se publica públicamente).
# Vacío = sin candado. En Streamlit Cloud se define en Secrets, no aquí.
APP_PASSWORD=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Dropi (proveedor) — aún no integrado de verdad, ver
# backend/app/integrations/dropi.py. Se genera desde el panel de Dropi,
# sección Integraciones, una vez tengas cuenta.
DROPI_INTEGRATION_KEY=

MIN_ROI=0.30
MIN_NET_PROFIT=20000
MAX_RISK_SCORE=0.50

DEFAULT_CURRENCY=COP
